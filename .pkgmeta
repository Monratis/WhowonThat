package-as: WhoWonThat

enable-toc-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - ".github"
  - ".gitignore"
  - ".luacheckrc"
  - ".luarc.json"
  - ".pkgmeta"
  - "AGENTS.md"
  - "build.ps1"
  - "CURSEFORGE_DESCRIPTION.md"
  - "dist"
  - "images"
  - "logo.webp"
  - "profil_questbang.txt"
  - "check.ps1"
  - "tools"
